# MongoDB connection string (MongoDB Atlas or self-hosted)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.example.mongodb.net/tiktok-pl?retryWrites=true&w=majority

# Random string used to sign the session cookie (at least 32 characters).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=

# The first admin account. It is created the first time you sign in with exactly these details
# while no admin exists yet. After that, change the password in the app (My account);
# these two values are then ignored and can be removed.
ADMIN_EMAIL=
ADMIN_PASSWORD=
# Optional display name for that first admin (default "Admin").
ADMIN_NAME=

# Time zone used for "Today", "This Week" and similar periods.
APP_TIMEZONE=Asia/Karachi
